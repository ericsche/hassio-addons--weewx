{
  "name": "WeeWX",
  "version": "1.0.58",
  "slug": "hassio_weewx",
  "description": "Home Assistant app for connecting weather stations using WeeWX",
  "url": "https://github.com/ericsche/hassio-addons--weewx",
  "init": false,
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "application",
  "boot": "auto",
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:weather-cloudy",
  "panel_title": "WeeWX",
  "ports": {
    "80/tcp": 80
  },
  "ports_description": {
    "80/tcp": "Interceptor driver port for receiving weather station data"
  },
  "map": [
    "config:rw"
  ],
  "options": {
    "data_path": "/config/weewx",
    "latitude": 47.5079,
    "longitude": 3.8406,
    "altitude": 134,
    "altitudeUnit": "meter",
    "location": "Maison",
    "units": "metricwx"
  },
  "schema": {
    "data_path": "str",
    "latitude": "float",
    "longitude": "float",
    "altitude": "int",
    "altitudeUnit": "str",
    "location": "str",
    "units": "str"
  }
}